#!/bin/sh
# La langue, le clavier, les mises à jour automatiques et le compte des
# élèves restent tels quels après la désinstallation : ce sont des réglages
# du système, que l'on change avec les outils de Mint.
set -e

case "$1" in
    remove|purge)
        deb-systemd-helper disable ocmintux-premier-demarrage.service >/dev/null || true
        deb-systemd-helper disable ocmintux-ventilation.service >/dev/null || true
        ;;
esac

if [ "$1" = purge ]; then
    rm -rf /var/lib/ocmintux
    rm -f /etc/ocmintux/ocmintux.conf
    rmdir /etc/ocmintux 2>/dev/null || true
    deb-systemd-helper purge ocmintux-premier-demarrage.service >/dev/null || true
    deb-systemd-helper purge ocmintux-ventilation.service >/dev/null || true
fi
